# LiteSpeed configuration to proxy /scraper/ to Docker Nginx on port 9080
# Copy this to: /home/vps-d6ea56ba.vps.ovh.net/public_html/.htaccess
# Or merge with existing .htaccess

<IfModule LiteSpeed>
  # Rewrite rules for /scraper/ - proxy to Docker Nginx
  RewriteEngine On
  RewriteBase /

  # Proxy /scraper/ and everything under it to Docker Nginx on port 9080
  RewriteRule ^scraper/(.*) http://127.0.0.1:9080/scraper/$1 [P,L]
</IfModule>
