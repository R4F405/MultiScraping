# Instagram — Sesión autenticada (modo Seguidores / Modo B)
# El endpoint de seguidores de Instagram requiere sesión. Copia el valor de la
# cookie `sessionid` de un navegador con la cuenta logueada (DevTools →
# Application → Cookies → instagram.com → sessionid) y pégalo aquí.
IG_SESSIONID=
# Opcionales — se derivan del sessionid si se dejan vacíos:
IG_DS_USER_ID=
IG_CSRFTOKEN=
# Alternativa: fichero JSON {"sessionid": "...", "csrftoken": "..."}
IG_SESSION_FILE=

# Instagram — Transporte (curl_cffi)
# Perfil de huella TLS ("none" para desactivar tras proxies que interceptan TLS)
IG_IMPERSONATE=chrome146
# CA bundle propio para proxies con interceptación TLS (vacío = CAs del sistema)
IG_CA_BUNDLE=

# Instagram — API móvil (Android). Desde sept. 2026 es la única vía que lista
# seguidores y devuelve email/teléfono (public_email / public_phone_number).
# Reutiliza el mismo IG_SESSIONID. Valores por defecto = instagrapi 3.0.20;
# cámbialos solo si Instagram rota versiones/doc_id.
# IG_MOBILE_APP_VERSION=449.0.0.52.84
# IG_MOBILE_VERSION_CODE=1079242191
# IG_MOBILE_LOCALE=es_ES
# IG_MOBILE_TIMEZONE_OFFSET=7200
# IG_FOLLOWERS_DOC_ID=284797047911918316998205836755

# Instagram — Modo Seguidores (Modo B)
IG_FOLLOWERS_PAGE_SIZE=50
IG_FOLLOWERS_DELAY_MIN=2.0
IG_FOLLOWERS_DELAY_MAX=5.0
IG_FOLLOWERS_MAX_PER_JOB=5000
# Anti-baneo: tope diario de seguidores por cuenta (0 = sin tope).
IG_LIMIT_DAILY_FOLLOWERS=1500
# Anti-baneo: pausa larga cada N seguidores para romper la cadencia de bot.
IG_FOLLOWERS_REST_EVERY=500
IG_FOLLOWERS_REST_SECONDS=45.0
# Desde sept. 2026 Instagram corta la lista de seguidores de muchas cuentas en
# ~50 en todos los endpoints. Si pasa, se busca DENTRO de la lista por prefijos
# (a, b, … ma, mb, …) y se juntan los resultados. Más profundidad = más
# seguidores encontrados y más peticiones (6 ≈ 80% de una cuenta de 16.000).
IG_FOLLOWERS_SEARCH_FALLBACK=1
IG_FOLLOWERS_SEARCH_MAX_DEPTH=6
# Anti-baneo: la sesión autenticada usa un proxy fijo (no rota IPs).
# 1 = fijo (recomendado), 0 = round-robin como los invitados.
IG_SESSION_PINNED_PROXY=1

# Instagram — Fase 2: enriquecer email + teléfono (una consulta por seguidor).
# Es la petición que Instagram limita más por cuenta: ve despacio.
IG_ENRICH_DELAY_MIN=8.0
IG_ENRICH_DELAY_MAX=15.0
# Tope diario de perfiles consultados (0 = sin tope)
IG_LIMIT_DAILY_PROFILES=500
IG_ENRICH_REST_EVERY=100
IG_ENRICH_REST_SECONDS=90
# Opcional: segunda cuenta solo para la Fase 2 (protege la cuenta principal)
IG_GUEST_SESSIONID=

# Instagram — Rate limiting (ajustable desde UI)
IG_LIMIT_DAILY_AUTHENTICATED=80
IG_LIMIT_HOURLY_AUTHENTICATED=20
IG_DELAY_UNAUTH_MIN=4.0
IG_DELAY_UNAUTH_MAX=9.0
IG_DELAY_AUTH_MIN=4.0
IG_DELAY_AUTH_MAX=10.0
IG_BACKOFF_INITIAL=60
IG_BACKOFF_MULTIPLIER=2
IG_BACKOFF_MAX=3600

# Instagram — Configuración general
IG_APP_ID=936619743392459
IG_CONCURRENCY=3
IG_MAX_RETRIES=3
IG_HEALTH_CHECK_INTERVAL=3600
IG_HEALTH_TEST_ACCOUNT=instagram

IG_PROXY_LIST=

IG_PROXY_ERROR_COOLDOWN=300
