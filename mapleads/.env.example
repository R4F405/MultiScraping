# ─── Proxies ────────────────────────────────────────────────────────────────
WEBSHARE_PROXY_USER=your_webshare_user
WEBSHARE_PROXY_PASS=your_webshare_pass
WEBSHARE_PROXY_HOST=proxy.webshare.io
WEBSHARE_PROXY_PORT=80

# ─── Lista de proxies estáticos (opcional) ──────────────────────────────────
# Si defines PROXY_LIST, tiene prioridad sobre HOST/PORT.
PROXY_LIST=

# ─── Base de datos ──────────────────────────────────────────────────────────
DB_PATH=./data/mapleads.db

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG

# ─── Límites por proxy individual ───────────────────────────────────────────
MAX_REQUESTS_PER_PROXY_BEFORE_COOLDOWN=30
PROXY_COOLDOWN_SECONDS=480

# ─── Concurrencia ───────────────────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=6
REQUEST_DELAY_MIN_SECONDS=1.0
REQUEST_DELAY_MAX_SECONDS=2.5

# ─── Circuit breaker ────────────────────────────────────────────────────────
ERROR_RATE_THRESHOLD=0.20
HIGH_ERROR_COOLDOWN_SECONDS=900

# ─── Límite duro diario ─────────────────────────────────────────────────────
MAX_REQUESTS_PER_DAY=999999999

# ─── Seguridad API (recomendado en producción) ─────────────────────────────
API_KEY=

# ─── Transporte Google Maps ─────────────────────────────────────────────────
# Perfil de huella TLS para curl_cffi ("none" para desactivar la
# impersonación, p. ej. detrás de proxies corporativos que interceptan TLS)
MAPS_IMPERSONATE=chrome131
# Ruta a un CA bundle propio (vacío = CAs del sistema)
MAPS_CA_BUNDLE=

# ─── Dedupe window (days): skip businesses seen recently ────────────────────
DEDUPE_DAYS=30

EMAIL_SCRAPER_FORCE_DIRECT=1
