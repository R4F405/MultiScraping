# LiteSpeed vhost.conf configuration snippet for proxying /scraper/
# Add this to: /usr/local/lsws/conf/vhosts/vps-d6ea56ba.vps.ovh.net/vhost.conf

# Location context for /scraper/
<context /scraper/>
  <allowBrowse>0</allowBrowse>
  <enableExpires>1</enableExpires>
  <expiresByType>
    text/html=A3600
  </expiresByType>

  # Proxy to Docker Nginx on port 9080
  <externalAddress>
    address: 127.0.0.1:9080
  </externalAddress>
</context>
